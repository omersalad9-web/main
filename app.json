{
  "expo": {
    "name": "Vault",
    "slug": "vault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A2E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vault.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Vault uses Face ID to protect your financial data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A2E"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.vault.app"
    },
    "plugins": [
      "expo-local-authentication",
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications"
    ]
  }
}
