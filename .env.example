# Polymarket API credentials
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# Polymarket condition IDs for monitored markets
# Update these to match currently active BTC/ETH up/down contracts
BTC_5M_UP_CONDITION_ID=
BTC_5M_DOWN_CONDITION_ID=
BTC_15M_UP_CONDITION_ID=
BTC_15M_DOWN_CONDITION_ID=
ETH_5M_UP_CONDITION_ID=
ETH_5M_DOWN_CONDITION_ID=
ETH_15M_UP_CONDITION_ID=
ETH_15M_DOWN_CONDITION_ID=

# Live trading (ALL THREE must be "true" to enable live mode)
ENABLE_LIVE_TRADING=false
CONFIRM_LIVE_TRADING=false
ACCEPT_LIVE_RISK=false

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database
DB_PATH=polymarket_arb/trades.db
