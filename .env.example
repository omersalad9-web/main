# ============================================================
# Africa Finance Review — Environment Variables
# Copy this file to .env.local and fill in all values.
# Never commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# DATABASE
# PostgreSQL connection string from Supabase (or any Postgres provider).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------
# REDIS (Upstash or self-hosted)
# Used by BullMQ for background job queues.
# Upstash format: rediss://default:TOKEN@HOST:PORT
# ------------------------------------------------------------
REDIS_URL="rediss://default:YOUR_UPSTASH_TOKEN@YOUR_HOST.upstash.io:6379"

# ------------------------------------------------------------
# ANTHROPIC (Claude AI)
# Used for article generation, summarisation, and signal analysis.
# Get your key at: https://console.anthropic.com/
# ------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-YOUR_API_KEY"

# ------------------------------------------------------------
# NEXT AUTH
# NEXTAUTH_SECRET: run `openssl rand -base64 32` to generate.
# NEXTAUTH_URL:    the canonical URL of your deployment.
# ------------------------------------------------------------
NEXTAUTH_SECRET="your-secret-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------
# GOOGLE OAUTH
# Create credentials at: https://console.cloud.google.com/
# Authorized redirect URI: $NEXTAUTH_URL/api/auth/callback/google
# ------------------------------------------------------------
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ------------------------------------------------------------
# NEWS API
# Used to fetch raw news headlines for the pipeline.
# Get a key at: https://newsapi.org/
# ------------------------------------------------------------
NEWSAPI_KEY="your_newsapi_key_here"

# ------------------------------------------------------------
# ALPHA VANTAGE (Market Data)
# Used for stock prices, equity snapshots, and historical data.
# Get a free key at: https://www.alphavantage.co/support/#api-key
# ------------------------------------------------------------
ALPHA_VANTAGE_KEY="your_alpha_vantage_key_here"

# ------------------------------------------------------------
# EXCHANGE RATE API (FX Rates)
# Used for African currency pairs and FX rate snapshots.
# Get a key at: https://www.exchangerate-api.com/
# ------------------------------------------------------------
EXCHANGE_RATE_API_KEY="your_exchange_rate_api_key_here"

# ------------------------------------------------------------
# STRIPE (Payments & Subscriptions)
# Used for Analyst and Diaspora Pro plan billing.
# Get keys at: https://dashboard.stripe.com/apikeys
# Webhook secret: set up endpoint at /api/webhooks/stripe
# ------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY"
STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_STRIPE_PUBLISHABLE_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_WEBHOOK_SECRET"

# Stripe Price IDs for subscription plans
STRIPE_ANALYST_PRICE_ID="price_YOUR_ANALYST_PLAN_PRICE_ID"
STRIPE_DIASPORA_PRO_PRICE_ID="price_YOUR_DIASPORA_PRO_PLAN_PRICE_ID"

# ------------------------------------------------------------
# RESEND (Transactional Email)
# Used for welcome emails, alerts, and digest newsletters.
# Get a key at: https://resend.com/api-keys
# ------------------------------------------------------------
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
RESEND_FROM_EMAIL="noreply@africafinancereview.com"
RESEND_FROM_NAME="Africa Finance Review"

# ------------------------------------------------------------
# PIPELINE SECRET
# Shared secret used to authenticate cron job requests to
# /api/pipeline. Generate with: openssl rand -hex 32
# ------------------------------------------------------------
PIPELINE_SECRET="your_pipeline_secret_hex_string_here"

# ------------------------------------------------------------
# APPLICATION URL
# The canonical public URL of the app (used in emails, OG tags, etc.)
# In production: https://africafinancereview.com
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Also expose Stripe publishable key to the client
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_STRIPE_PUBLISHABLE_KEY"
